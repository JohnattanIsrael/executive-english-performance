# ---------------------------------------------------------------------------
# Executive English Performance — environment configuration
# Copy to .env.local for local development. All values are optional.
# ---------------------------------------------------------------------------

# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sub-path when hosted at https://<user>.github.io/<repo>/ (set automatically in CI).
NEXT_PUBLIC_BASE_PATH=

# Data source for services: "mock" (default) uses local sample data.
# Switch to "api" once real service implementations exist in src/lib/services/api.
NEXT_PUBLIC_DATA_SOURCE=mock

# Lead capture. When set, every form submission is POSTed as JSON to this URL
# (Formspree, Zapier/Make webhook, HubSpot/Pipedrive middleware, your own API...).
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Scheduling after an assessment request (Google Calendar appointment schedule, Cal.com, Calendly...).
# BOOKING_URL: public booking link (button / fallback link).
# BOOKING_EMBED_URL: embeddable page shown inline. For Google Calendar use the full
#   https://calendar.google.com/calendar/appointments/schedules/<id>?gv=true URL
#   (the calendar.app.google short link cannot be embedded).
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_BOOKING_EMBED_URL=

# Analytics provider: none | console | ga4 | plausible | posthog
NEXT_PUBLIC_ANALYTICS_PROVIDER=console
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
